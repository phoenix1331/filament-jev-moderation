{
    "name": "phoenix1331/filament-jev-moderation",
    "description": "A Filament review queue for Jev Moderation: approve, reject and reclassify flagged content, trace every decision, and see whether your thresholds match what your moderators actually decide.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "moderation",
        "content-moderation",
        "jev",
        "review-queue",
        "trust-and-safety",
        "calibration",
        "ai",
        "ugc"
    ],
    "homepage": "https://phoenix1331.github.io/filament-jev-moderation",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/filament-jev-moderation/issues",
        "source": "https://github.com/phoenix1331/filament-jev-moderation"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "phoenix1331/laravel-jev-moderation": "^0.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.6|^11.3",
        "pestphp/pest": "^4.3|^5.3",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.1|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\FilamentJevModeration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\FilamentJevModeration\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\FilamentJevModeration\\FilamentJevModerationServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "check": [
            "@lint:test",
            "@analyse",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:test": "Check code style with Pint without changing files",
        "analyse": "Run Larastan at max level over src/, tests/Fixtures/ and workbench/",
        "test": "Run the Pest suite",
        "test:coverage": "Run the Pest suite with the 90% coverage gate on src/",
        "check": "Run style check, static analysis and the coverage gate, in that order",
        "clear": "Reset the Testbench skeleton",
        "prepare": "Discover package providers in the Testbench skeleton",
        "build": "Build the workbench: publish assets, recreate SQLite, migrate and seed demo data",
        "serve": "Build the workbench and serve the demo panel"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
